{
  "description": "Categorical feature mappings for clean_layers production model. Must be consistent with training data.",
  "version": "1.0.0",
  "training_date": "2025-11-11",
  "mappings": {
    "Event_Industry": {
      "-": 0,
      "Athletics": 1,
      "Church": 2,
      "Community": 3,
      "Corporate": 4,
      "Daycare": 5,
      "Education": 6,
      "Festival": 7,
      "Other": 8,
      "Private": 9,
      "unknown": 10
    },
    "equipment_type": {
      "Blended truck": 0,
      "kiosk": 1,
      "mini": 2,
      "truck": 3,
      "unknown": 4
    },
    "Duration_Bracket": {
      "Short (0-2h)": 0,
      "Medium (2-4h)": 1,
      "Long (4-6h)": 2,
      "Extended (6h+)": 3,
      "unknown": 4
    },
    "Hour_Bucket": {
      "Morning": 0,
      "Midday": 1,
      "Afternoon": 2,
      "Evening": 3,
      "Night": 4,
      "unknown": 5
    },
    "Season": {
      "Winter": 0,
      "Spring": 1,
      "Summer": 2,
      "Fall": 3,
      "unknown": 4
    },
    "School_Season": {
      "0": 0,
      "1": 1
    }
  },
  "interaction_features": {
    "Equipment_Industry": {
      "description": "Generated by concatenating equipment_type + '_' + Event_Industry",
      "example": "truck_Private"
    },
    "Equipment_Season": {
      "description": "Generated by concatenating equipment_type + '_' + Season",
      "example": "truck_Summer"
    }
  },
  "notes": [
    "Extracted from Kona_AI_ML/data/Master_Events_All_Franchises_FINAL_CLEAN.csv (1,468 events)",
    "School_Season is represented as 0 (not school season) or 1 (school season)",
    "Interaction features are dynamically encoded using LabelEncoder at runtime",
    "Unknown values are handled with dedicated 'unknown' category",
    "All categorical values are case-sensitive and must match exactly",
    "Event_Industry '-' represents undefined/null industry type"
  ]
}
