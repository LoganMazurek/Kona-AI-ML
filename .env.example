# Copy to .env next to docker-compose.yml and fill in real values.
# .env is gitignored -- never commit it, and never put real secrets in this file.

# Flask session-signing key. REQUIRED in production; `docker compose up` aborts
# without it. Anyone who knows this value can forge a session cookie for any
# franchise, so treat it like a password.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Email (password reset / username reminder), optional ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true
